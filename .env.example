# Copy to .env and fill in. Do not commit real values.

# Server-only MySQL connection and signing secret.
DATABASE_URL=mysql://db_user:db_password@localhost:3306/db_name
SESSION_SECRET=replace-with-a-random-64-character-secret
VITE_SITE_URL=https://roambengal.com

# Optional individual MySQL values, used only when DATABASE_URL is unavailable.
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=db_name
# MYSQL_USER=db_user
# MYSQL_PASSWORD=db_password

# New booking / inquiry email notifications (server-only). Leave blank to disable.
# Hostinger mailbox: smtp.hostinger.com, port 465, the full mailbox address and its password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=bookings@roambengal.com
SMTP_PASS=mailbox-password
# Optional; must be the same mailbox (or an alias of it) or the server may reject it.
# SMTP_FROM=Roam Bengal <bookings@roambengal.com>
# Where notifications go. Comma-separate several addresses.
INQUIRY_NOTIFICATION_TO=you@example.com

# Playwright end-to-end tests (npm run test:e2e). An existing admin account —
# accounts are provisioned by hand, the suite does not create one.
PLAYWRIGHT_TEST_EMAIL=admin@example.com
PLAYWRIGHT_TEST_PASSWORD=change-me
PLAYWRIGHT_BASE_URL=http://localhost:3000
